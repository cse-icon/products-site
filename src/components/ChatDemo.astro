---
interface Chart {
  type: 'line' | 'bar';
  values: number[];
  labels?: string[];
  reference?: number;
  caption?: string;
}

interface Exchange {
  question: string;
  tool: string;
  answer: string;
  chart?: Chart;
}

interface Props {
  exchanges: Exchange[];
}

const { exchanges } = Astro.props;
---

<section class="pb-6 sm:pb-10">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div
      class="chat-demo overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] shadow-xl"
      data-exchanges={JSON.stringify(exchanges)}
    >
      <div class="flex items-center gap-2 border-b border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-slate-300 dark:bg-slate-600"></span>
        <span class="ml-2 text-xs font-medium text-[var(--color-text-muted)]">AI assistant</span>
      </div>

      <div class="chat-log flex h-[26rem] flex-col gap-3 overflow-y-hidden scroll-smooth p-4 sm:h-[24rem] sm:p-5" aria-hidden="true">
        <div class="chat-q">{exchanges[0].question}</div>
        <div class="chat-a">{exchanges[0].answer}</div>
      </div>

      <div class="flex items-center gap-2 border-t border-[var(--color-border)] px-4 py-3">
        <div class="chat-input min-h-[1.25rem] flex-1 truncate text-sm text-[var(--color-text-muted)]">Ask a question…</div>
        <span class="rounded-md bg-brand-600 px-3 py-1 text-xs font-semibold text-white">Send</span>
      </div>
    </div>
    <p class="mt-3 text-center text-xs text-[var(--color-text-muted)]">Example conversation. Tag names and values are illustrative.</p>
  </div>
</section>

<style is:global>
  .chat-demo .chat-q {
    margin-left: auto;
    max-width: 85%;
    border-radius: 1rem 1rem 0.25rem 1rem;
    background: var(--color-brand-600);
    color: #fff;
    padding: 0.6rem 1rem;
    font-size: 0.875rem;
  }
  .chat-demo .chat-a {
    max-width: 92%;
    border-radius: 1rem 1rem 1rem 0.25rem;
    background: var(--color-surface);
    color: var(--color-text);
    padding: 0.6rem 1rem;
    font-size: 0.875rem;
  }
  .chat-demo .chat-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .chat-demo .chat-tool .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-brand-500);
    animation: chat-pulse 1s ease-in-out infinite;
  }
  .chat-demo .chat-tool.done .dot {
    animation: none;
    background: #10b981;
  }
  .chat-demo .chat-chart {
    margin-top: 0.6rem;
    border-radius: 0.6rem;
    background: var(--color-bg);
    padding: 0.5rem 0.6rem 0.3rem;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .chat-demo .chat-chart.shown {
    opacity: 1;
  }
  .chat-demo .chat-chart svg {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    color: var(--color-brand-600);
  }
  .chat-demo .chat-chart .draw {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    transition: stroke-dashoffset 1.4s ease-out;
  }
  .chat-demo .chat-chart.shown .draw {
    stroke-dashoffset: 0;
  }
  .chat-demo .chat-chart .bar {
    transform: scaleY(0);
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform 0.8s ease-out;
  }
  .chat-demo .chat-chart.shown .bar {
    transform: scaleY(1);
  }
  @keyframes chat-pulse {
    50% { opacity: 0.3; }
  }
</style>

<script>
  type Chart = { type: 'line' | 'bar'; values: number[]; labels?: string[]; reference?: number; caption?: string };
  type Exchange = { question: string; tool: string; answer: string; chart?: Chart };

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const W = 320;
  const H = 110;
  const PAD = 18;

  async function typeInto(el: HTMLElement, text: string, msPerChar: number, onTick?: () => void) {
    el.textContent = '';
    for (const ch of text) {
      el.textContent += ch;
      onTick?.();
      await sleep(msPerChar);
    }
  }

  function lineSvg(c: Chart): string {
    const all = c.reference === undefined ? c.values : [...c.values, c.reference];
    const min = Math.min(...all);
    const max = Math.max(...all);
    const y = (v: number) => H - PAD - ((v - min) / (max - min || 1)) * (H - 2 * PAD);
    const x = (i: number) => PAD + (i / (c.values.length - 1)) * (W - 2 * PAD);
    const pts = c.values.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
    const ref = c.reference === undefined ? '' :
      `<line x1="${PAD}" x2="${W - PAD}" y1="${y(c.reference)}" y2="${y(c.reference)}" stroke="var(--color-text-muted)" stroke-opacity=".8" stroke-dasharray="4 4"/>`;
    const labels = (c.labels ?? []).map((l, i, arr) =>
      `<text x="${PAD + (i / Math.max(arr.length - 1, 1)) * (W - 2 * PAD)}" y="${H - 2}" font-size="9" text-anchor="middle" fill="var(--color-text-muted)">${l}</text>`).join('');
    return `<svg viewBox="0 0 ${W} ${H}">${ref}<polyline class="draw" points="${pts}" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>${labels}</svg>`;
  }

  function barSvg(c: Chart): string {
    const max = Math.max(...c.values);
    const slot = (W - 2 * PAD) / c.values.length;
    const bars = c.values.map((v, i) => {
      const h = (v / max) * (H - 2 * PAD - 10);
      const bx = PAD + i * slot + slot * 0.2;
      const label = c.labels?.[i] ?? '';
      return `<rect class="bar" x="${bx}" y="${H - PAD - h}" width="${slot * 0.6}" height="${h}" rx="2" fill="currentColor" fill-opacity="${v === max ? 1 : 0.45}" style="transition-delay:${i * 80}ms"/>` +
        `<text x="${bx + slot * 0.3}" y="${H - PAD - h - 3}" font-size="9" text-anchor="middle" fill="var(--color-text)">${v}</text>` +
        `<text x="${bx + slot * 0.3}" y="${H - 4}" font-size="9" text-anchor="middle" fill="var(--color-text-muted)">${label}</text>`;
    }).join('');
    return `<svg viewBox="0 0 ${W} ${H}">${bars}</svg>`;
  }

  function el(cls: string, text = ''): HTMLDivElement {
    const d = document.createElement('div');
    d.className = cls;
    d.textContent = text;
    return d;
  }

  async function run(root: HTMLElement) {
    const exchanges: Exchange[] = JSON.parse(root.dataset.exchanges!);
    const log = root.querySelector<HTMLElement>('.chat-log')!;
    const input = root.querySelector<HTMLElement>('.chat-input')!;
    const toBottom = () => { log.scrollTop = log.scrollHeight; };

    while (true) {
      log.replaceChildren();
      for (const ex of exchanges) {
        input.style.color = 'var(--color-text)';
        await typeInto(input, ex.question, 35);
        await sleep(400);
        input.textContent = 'Ask a question…';
        input.style.color = '';
        log.append(el('chat-q', ex.question));
        toBottom();
        await sleep(500);

        const tool = el('chat-tool');
        tool.innerHTML = '<span class="dot"></span>';
        tool.append(ex.tool);
        log.append(tool);
        toBottom();
        await sleep(1400);
        tool.classList.add('done');

        const bubble = el('chat-a');
        const text = el('');
        bubble.append(text);
        log.append(bubble);
        await typeInto(text, ex.answer, 12, toBottom);

        if (ex.chart) {
          const chart = el('chat-chart');
          chart.innerHTML = ex.chart.type === 'line' ? lineSvg(ex.chart) : barSvg(ex.chart);
          if (ex.chart.caption) chart.append(el('mt-1 text-[11px] text-[var(--color-text-muted)]', ex.chart.caption));
          bubble.append(chart);
          toBottom();
          await sleep(50);
          chart.classList.add('shown');
          toBottom();
          await sleep(1500);
        }
        await sleep(2500);
      }
      await sleep(3000);
    }
  }

  // Reduced-motion users keep the static first exchange rendered on the server.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.chat-demo').forEach(run);
  }
</script>

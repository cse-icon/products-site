---
interface Step {
  title: string;
  detail: string;
  edge?: string;
}

interface Props {
  steps: Step[];
  caption?: string;
}

const { steps, caption } = Astro.props;
---

<section class="pb-6 sm:pb-10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flow rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5 shadow-xl sm:p-6">
      {steps.map((step, i) => (
        <>
          <div class="flow-node" style={`animation-delay:${i * 150}ms`}>
            <div class="text-sm font-bold text-[var(--color-text)]">{step.title}</div>
            <div class="mt-1 text-xs text-[var(--color-text-muted)]">{step.detail}</div>
          </div>
          {i < steps.length - 1 && (
            <div class="flow-edge">
              <div class="flow-line"><span class="flow-dot" style={`animation-delay:${i * 0.6}s`}></span></div>
              {step.edge && <div class="flow-label">{step.edge}</div>}
            </div>
          )}
        </>
      ))}
    </div>
    {caption && <p class="mt-3 text-center text-xs text-[var(--color-text-muted)]">{caption}</p>}
  </div>
</section>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }
  .flow-node {
    flex: 1 1 0;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-brand-600);
    border-radius: 0.75rem;
    background: var(--color-surface);
    padding: 0.85rem 1rem;
    animation: flow-in 0.5s ease-out both;
  }
  .flow-edge {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 3rem;
  }
  .flow-line {
    position: relative;
    width: 2px;
    height: 100%;
    background: repeating-linear-gradient(to bottom, var(--color-brand-400) 0 4px, transparent 4px 8px);
  }
  .flow-line::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    translate: -50% 0;
    border: 5px solid transparent;
    border-top-color: var(--color-brand-600);
    border-bottom: 0;
  }
  .flow-dot {
    position: absolute;
    left: 50%;
    width: 8px;
    height: 8px;
    translate: -50% 0;
    border-radius: 999px;
    background: var(--color-brand-600);
    animation: flow-down 1.8s linear infinite;
  }
  .flow-label {
    position: absolute;
    left: calc(50% + 0.75rem);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .flow {
      flex-direction: row;
      align-items: center;
    }
    .flow-edge {
      flex: 0 0 6.5rem;
      height: auto;
      flex-direction: column;
    }
    .flow-line {
      width: 100%;
      height: 2px;
      background: repeating-linear-gradient(to right, var(--color-brand-400) 0 4px, transparent 4px 8px);
    }
    .flow-line::after {
      bottom: auto;
      top: 50%;
      left: auto;
      right: -2px;
      translate: 0 -50%;
      border: 5px solid transparent;
      border-left-color: var(--color-brand-600);
      border-right: 0;
    }
    .flow-dot {
      top: 50%;
      left: 0;
      translate: 0 -50%;
      animation-name: flow-right;
    }
    .flow-label {
      position: static;
      margin-top: 0.4rem;
      text-align: center;
      white-space: normal;
      line-height: 1.2;
    }
  }
  @keyframes flow-down {
    from { top: 0; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    to { top: calc(100% - 8px); opacity: 0; }
  }
  @keyframes flow-right {
    from { left: 0; opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    to { left: calc(100% - 8px); opacity: 0; }
  }
  @keyframes flow-in {
    from { opacity: 0; translate: 0 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-dot { display: none; }
    .flow-node { animation: none; }
  }
</style>

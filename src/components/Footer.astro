---
/**
 * Site footer. Previously duplicated — and divergent — between the product and
 * roadmap pages; now rendered once by BaseLayout for every page.
 */
interface Props {
  /** Tint the footer with the brand colour instead of the page surface. */
  variant?: 'plain' | 'brand';
  /** Link classes, supplied by BaseLayout so both share one source of truth. */
  linkClass: string;
}

const { variant = 'plain', linkClass } = Astro.props;

const year = new Date().getFullYear();

const shellClass =
  variant === 'brand'
    ? 'bg-brand-600 py-5 text-center'
    : 'border-t border-[var(--color-border)] py-6 text-center';

const copyrightClass =
  variant === 'brand' ? 'text-xs text-white/60' : 'text-xs text-[var(--color-text-muted)]';
---

<footer class={shellClass}>
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-2 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-xs">
      <a href="https://cse-icon.com" class={linkClass}>CSE ICON, Inc.</a>
      <a href="mailto:sales@cse-icon.com" class={linkClass}>sales@cse-icon.com</a>
      <a href="/" class={linkClass}>All products</a>
    </div>
    <p class={copyrightClass}>
      &copy; {year} CSE ICON, Inc. All rights reserved.
    </p>
    <p class={`${copyrightClass} max-w-3xl`}>
      AVEVA and the AVEVA logo are a trademark or registered trademark of AVEVA Group Limited in
      the U.S. and other countries. Canary and Canary Historian are trademarks of Canary Labs. Schneider Electric, Geo SCADA, ClearSCADA, and ViewX are trademarks of Schneider Electric. Snowflake is a registered trademark of Snowflake Inc. Microsoft, Azure, and Teams are trademarks of the Microsoft group of companies. Apache, Apache Parquet, and Apache Iceberg are trademarks of the Apache Software Foundation. Okta is a registered trademark of Okta, Inc. Cloudflare is a registered trademark of Cloudflare, Inc. Slack is a registered trademark of Slack Technologies, LLC.
    </p>
    <p class={`${copyrightClass} max-w-3xl`}>
      All other product names, logos, and brands are the property of their respective owners. Company,
      product, and service names used on this site are for identification purposes only. Use of
      these names, logos, and brands does not imply affiliation or endorsement unless expressly
      stated.
    </p>
  </div>
</footer>
